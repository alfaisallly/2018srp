# DCMS Environment Configuration
# Copy to .env and adjust for your Windows 11 environment

APP_NAME=DCMS
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://dcms:dcms_password@localhost:5432/dcms

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring
POLL_INTERVAL_SECONDS=300
SNMP_TIMEOUT=10
SSH_TIMEOUT=30

# Alerts
ALERT_EMAIL_FROM=dcms@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
