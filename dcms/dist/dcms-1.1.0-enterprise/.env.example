# DCMS Environment Configuration
# Copy to .env and adjust for production

APP_NAME=DCMS
APP_VERSION=1.1.0-enterprise
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# PostgreSQL (local or Docker)
POSTGRES_USER=dcms
POSTGRES_PASSWORD=change-strong-password-in-production
POSTGRES_DB=dcms
DATABASE_URL=postgresql+asyncpg://dcms:change-strong-password-in-production@localhost:5432/dcms

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
DCMS_PORT=8080
DCMS_WORKERS=2

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring
POLL_INTERVAL_SECONDS=300
SNMP_TIMEOUT=10
SSH_TIMEOUT=30

# Alerts (optional)
ALERT_EMAIL_FROM=dcms@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
